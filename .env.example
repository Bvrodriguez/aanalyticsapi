# Copy this file to .env and fill in values from your Adobe Developer Console
# OAuth Server-to-Server credential (Project > Adobe Analytics API).
# Never commit the real .env file.

ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=
ADOBE_ORG_ID=
# Comma-separated scopes exactly as shown on the credential details page in
# the Developer Console (varies by console version).
ADOBE_SCOPES=openid,AdobeID,read_organizations,additional_info.projectedProductContext,session

# Optional: skip discovery and pin a specific report suite's Global Company ID
# (from https://analytics.adobe.io/discovery/me).
ADOBE_GLOBAL_COMPANY_ID=
